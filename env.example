# Copiá este archivo a ".env" y completá con tus datos reales.

# Cadena de conexión a PostgreSQL local.
# Formato: postgresql://usuario:password@localhost:5432/nombre_base
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/soloventas_ia"

# Clave secreta para firmar la sesión de login. Generá una propia con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="reemplazar_por_una_clave_larga_y_aleatoria"
